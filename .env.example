# 複製成 .env 再填實際的值。.env 已經在 .gitignore 裡，不會進版控。
#
# 這個檔案存在的理由：application.yml 裡的 DB_PASSWORD 刻意沒有預設值。
# 有預設值的話，環境變數沒設到時它會靜默退回一個公開在 GitHub 上的密碼，
# 而「用弱密碼啟動成功」比「啟動失敗」危險得多——因為沒有人會發現。

# ---- 資料庫 ----
# docker compose 會用這三個值同時設定 Postgres 容器與應用。
DB_URL=jdbc:postgresql://db:5432/career_toolkit
DB_USER=ct_user
DB_PASSWORD=請換成一個真正的密碼

# ---- 檔案儲存 ----
# 容器裡的路徑，對應 compose 的 ct-files volume。
STORAGE_ROOT=/var/lib/career-toolkit/files

# ---- 積木選擇 ----
# 每人每日上限。現在的選擇器零成本，接了會計費的 LLM 之後這就是成本上限。
SELECTION_DAILY_QUOTA=200

# ---- 診斷 ----
# 要看 Hibernate 產生的 SQL 時改成 debug。正式環境維持 info。
SQL_LOG_LEVEL=info
