# build context 越小，docker build 越快。
# 這些東西送進 build context 除了拖慢速度，還可能把本機的秘密帶進 image。
target/
.git/
.github/
.idea/
.vscode/
*.iml
.mvn/wrapper/maven-wrapper.jar

# 前端：node_modules 動輒上萬個檔案，送進 build context 會拖慢每一次 build。
# frontend 階段自己會跑 npm ci。
frontend/node_modules/
frontend/dist/
# 本機 build 出來的靜態檔也不要帶進去，frontend 階段會重新產生
src/main/resources/static/

# 本機密鑰絕對不能進 image
.env
.env.*

# 文件與計畫不影響 build
*.md
